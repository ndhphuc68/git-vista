{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc", "import", "react"],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".codegraph/**",
    ".superpowers/**",
    "coverage/**",
    "dist/**",
    "node_modules/**",
    "playwright-report/**",
    "src-tauri/**",
    "src/ipc/bindings.generated.ts",
    "test-results/**"
  ],
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "prefer-const": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-explicit-any": "warn",
    "import/no-duplicates": "error",
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": ["**/ipc/*", "**/ipc"],
            "message": "Component phải gọi qua features/*/api, không import ipc trực tiếp."
          },
          {
            "group": ["**/features/*/components/*", "**/features/*/api/*", "**/features/*/model/*"],
            "message": "Import qua features/<name>/index.ts, không chọc vào nội bộ feature."
          }
        ]
      }
    ],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "max-lines": ["warn", { "max": 300, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": ["warn", { "max": 80, "skipBlankLines": true, "skipComments": true }],
    "complexity": ["warn", 15],
    "max-depth": ["warn", 4],
    "max-params": ["warn", 5],
    "max-nested-callbacks": ["warn", 3]
  },
  "overrides": [
    {
      "files": ["src/test/**", "**/*.test.ts", "**/*.test.tsx", "e2e/**"],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "max-nested-callbacks": "off"
      }
    },
    {
      "files": ["src/features/*/api/**", "src/ipc/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/shared/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/ipc/*", "**/ipc", "**/store/*", "**/i18n", "**/i18n/*"],
                "message": "shared/ui phải thuần: nhận mọi thứ qua props."
              }
            ]
          }
        ]
      }
    }
  ]
}
